# Copiar como .env.local y completar. NUNCA subir .env.local a GitHub.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Llave para cifrar certificados y tokens. Generar con: openssl rand -base64 32
SECRETOS_LLAVE=
# Clave que usa la tarea automática para llamar a /api/procesar. Generar con: openssl rand -hex 24
CRON_SECRET=
# Monto a partir del cual ARCA exige identificar al comprador (confirmar con el contador)
UMBRAL_IDENTIFICACION=10000000
